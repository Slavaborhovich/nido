rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn()    { return request.auth != null; }
    // the system admin (slava): manages families and users everywhere — but sees content only of his own family
    function boot()        { return signedIn() && request.auth.uid == 'K2TaGlPsCJQ7W4HPdaOwQqvRKGS2'; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile()  { return signedIn() && exists(profilePath()); }
    function profile()     { return get(profilePath()).data; }
    function member()      { return hasProfile() && profile().active == true; }
    function myFamily()    { return hasProfile() ? profile().get('family', 'home') : 'home'; }
    function role()        { return profile().role; }
    function inFamily(fid) { return (member() || boot()) && myFamily() == fid; }
    function canEditIn(fid){ return inFamily(fid) && (boot() || role() in ['admin', 'editor']); }
    function isFamAdmin(fid){ return member() && role() == 'admin' && myFamily() == fid; }

    // families: name + content. Test environment only for the first family.
    match /families/{fid} {
      allow read:  if boot() || inFamily(fid);
      allow write: if boot();
      match /envs/{env}/{col}/{id} {
        allow read:  if inFamily(fid) && (env == 'prod' || (env == 'test' && fid == 'home'));
        allow write: if canEditIn(fid) && (env == 'prod' || (env == 'test' && fid == 'home'));
      }
      // "פתק על המקרר": only sender + recipients see it; id = env_day_sender[_n] → up to each person's noteLimit (set by the admin) per day
      match /notes/{id} {
        allow get:    if inFamily(fid) && (resource == null || request.auth.uid in resource.data.to || resource.data.from == request.auth.uid);
        allow list:   if inFamily(fid) && request.auth.uid in resource.data.to;
        allow create: if inFamily(fid) && request.resource.data.from == request.auth.uid
                         && request.resource.data.env in ['prod', 'test']
                         && ((request.resource.data.get('seq', 1) == 1 && id == request.resource.data.env + '_' + request.resource.data.day + '_' + request.auth.uid)
                             || (request.resource.data.get('seq', 1) is int && request.resource.data.seq >= 2
                                 && request.resource.data.seq <= profile().get('noteLimit', 1)
                                 && id == request.resource.data.env + '_' + request.resource.data.day + '_' + request.auth.uid + '_' + string(request.resource.data.seq)))
                         && request.resource.data.text is string && request.resource.data.text.size() <= 200
                         && request.resource.data.to is list && request.resource.data.to.size() > 0 && request.resource.data.to.size() <= 10;
        allow update: if inFamily(fid) && request.auth.uid in resource.data.to
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
                         && request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid]);
      }
      // the system admin may wipe a whole family (deleting needs to list what's there)
      match /{rest=**} {
        allow list, delete: if boot();
      }
      match /meta/{doc} {
        allow read, write: if canEditIn(fid);
      }
    }

    // old location of our data (before families) — read-only backup, used once for the move
    match /envs/{env}/{col}/{id} {
      allow read:  if inFamily('home');
      allow write: if false;
    }

    // people
    match /users/{uid} {
      allow get:  if boot() || (signedIn() && request.auth.uid == uid) || (member() && resource.data.get('family', 'home') == myFamily());
      allow list: if boot() || (member() && resource.data.family == myFamily());
      // the system admin: anything
      allow create, update, delete: if boot();
      // a family admin: only regular people in their own family — never other admins, the note limit, or another family
      allow create: if isFamAdmin(request.resource.data.family)
                       && request.resource.data.role in ['editor', 'viewer']
                       && request.resource.data.get('noteLimit', 1) == 1;
      allow update: if isFamAdmin(resource.data.get('family', 'home')) && request.auth.uid != uid
                       && resource.data.get('role', 'editor') != 'admin'
                       && request.resource.data.role in ['editor', 'viewer']
                       && request.resource.data.get('family', 'home') == resource.data.get('family', 'home')
                       && request.resource.data.get('noteLimit', 1) == resource.data.get('noteLimit', 1);
      allow delete: if isFamAdmin(resource.data.get('family', 'home')) && resource.data.get('role', 'editor') != 'admin';
      // everyone: their own name, colour, photo, settings
      allow update: if member() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'color', 'photo', 'notif', 'lastSeen', 'build', 'lastAct', 'act']);
    }

    // usage counters per family (numbers and dates only) — written by its members, read by the system admin
    match /stats/{fid} {
      allow read, delete: if boot();
      allow create, update: if (inFamily(fid) || boot())
        && request.resource.data.keys().hasOnly(['items', 'bytes', 'sizedAt', 'lastAct', 'days', 'adds', 'last', 'errs']);
    }

    // announcements from the system admin: to everyone or to one family
    match /announcements/{id} {
      allow read:   if boot() || (member() && (resource.data.target == 'all' || resource.data.target == myFamily()));
      allow write:  if boot();
    }

    // username -> e-mail lookup, needed before signing in (names are unique across all families)
    match /logins/{username} {
      allow get: if true;
      allow create, update, delete: if boot();
      allow create: if member() && role() == 'admin' && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.get('family', 'home') == myFamily();
      allow delete: if member() && role() == 'admin' && get(/databases/$(database)/documents/users/$(resource.data.uid)).data.get('family', 'home') == myFamily();
    }
  }
}
